@model IEnumerable<SnowStoreWeb.Models.PopupBanner>
@using SnowStoreWeb.Models

@{
    ViewData["Title"] = "Quản lý Popup Banner";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">@ViewData["Title"]</h3>
                    <div>
                        <button id="reorderBtn" class="btn btn-warning me-2">
                            <i class="fas fa-arrows-alt me-2"></i>Reorder Mode
                        </button>
                        <a href="@Url.Action("Create")" class="btn btn-success">
                            <i class="fas fa-plus"></i> Thêm mới
                        </a>
                    </div>
                </div>

                <!-- Reorder Mode Alert -->
                <div id="reorderAlert" class="alert alert-info m-3 d-none" role="alert">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Chế độ sắp xếp:</strong> Kéo thả các hàng để thay đổi thứ tự, sau đó nhấn "Lưu thứ tự" để áp dụng.
                    <button id="saveOrderBtn" class="btn btn-success btn-sm ms-3">
                        <i class="fas fa-save me-1"></i>Lưu thứ tự
                    </button>
                    <button id="cancelOrderBtn" class="btn btn-secondary btn-sm ms-2">
                        <i class="fas fa-times me-1"></i>Hủy
                    </button>
                </div>

                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th width="50" id="dragHandleHeader" class="d-none text-center">
                                            <i class="fas fa-grip-vertical"></i>
                                        </th>
                                        <th>ID</th>
                                        <th>Hình ảnh</th>
                                        <th>Tiêu đề</th>
                                        <th>Mô tả</th>
                                        <th>Thứ tự</th>
                                        <th>Trạng thái</th>
                                        <th>Ngày tạo</th>
                                        <th>Ngày cập nhật</th>
                                        <th id="actionsHeader">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="sortableTable">
                                    @foreach (var item in Model)
                                    {
                                        <tr data-id="@item.Id">
                                            <td class="drag-handle d-none text-center" style="cursor: move;">
                                                <i class="fas fa-grip-vertical text-muted"></i>
                                            </td>
                                            <td>@item.Id</td>
                                            <td>
                                                <img src="@item.ImageUrl" alt="@item.Title"
                                                     class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;" />
                                            </td>
                                            <td>@item.Title</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.Description))
                                                {
                                                    @(item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-primary order-badge">@item.DisplayOrder</span>
                                            </td>
                                            <td>
                                                @if (item.Status == PopupStatus.Active)
                                                {
                                                    <span class="badge bg-success">Hoạt động</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Không hoạt động</span>
                                                }
                                            </td>
                                            <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@item.UpdatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="actions-cell">
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("Details", new { id = item.Id })"
                                                       class="btn btn-info btn-sm" title="Chi tiết">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="@Url.Action("Edit", new { id = item.Id })"
                                                       class="btn btn-primary btn-sm" title="Sửa">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <form method="post" action="@Url.Action("Delete", new { id = item.Id })"
                                                          style="display: inline-block;"
                                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa popup banner này không?')">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm" title="Xóa">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Phân trang -->
                        @if (ViewBag.TotalPages > 1)
                        {
                            <nav aria-label="Page navigation" id="paginationSection">
                                <ul class="pagination justify-content-center">
                                    @if (ViewBag.CurrentPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1 })">
                                                Trước
                                            </a>
                                        </li>
                                    }

                                    @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                                    {
                                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                            <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                                        </li>
                                    }

                                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1 })">
                                                Tiếp
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        }

                        <div class="text-muted mt-3" id="recordInfo">
                            Hiển thị @((ViewBag.CurrentPage - 1) * 10 + 1) - @(Math.Min(ViewBag.CurrentPage * 10, ViewBag.TotalItems))
                            trong tổng số @ViewBag.TotalItems bản ghi
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <h5 class="text-muted">Không có popup banner nào</h5>
                            <a href="@Url.Action("Create")" class="btn btn-success mt-2">
                                <i class="fas fa-plus"></i> Thêm popup banner đầu tiên
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1055;">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="5000">
            <div class="toast-header bg-success text-white">
                <i class="fas fa-check-circle me-2"></i>
                <strong class="me-auto">Thành công</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">
                @TempData["SuccessMessage"]
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="7000">
            <div class="toast-header bg-danger text-white">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong class="me-auto">Lỗi</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">
                @TempData["ErrorMessage"]
            </div>
        </div>
    }
</div>

@section Scripts {
    <!-- SortableJS CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>

    <script>
        $(document).ready(function () {
            // Auto hide toasts after delay
            $('.toast').each(function () {
                var delay = $(this).data('bs-delay') || 5000;
                var toast = this;

                setTimeout(function () {
                    $(toast).fadeOut('slow', function () {
                        $(this).remove();
                    });
                }, delay);
            });

            // Manual close toast
            $('.toast .btn-close').click(function () {
                $(this).closest('.toast').fadeOut('slow', function () {
                    $(this).remove();
                });
            });
        });

        // Reorder Mode Variables
        let reorderMode = false;
        let sortable = null;

        // Initialize Sortable
        document.addEventListener('DOMContentLoaded', function () {
            const tbody = document.getElementById('sortableTable');

            sortable = new Sortable(tbody, {
                animation: 150,
                disabled: true,
                ghostClass: 'table-warning',
                dragClass: 'table-info',
                forceFallback: true,
                onEnd: function (evt) {
                    updateOrderBadges();
                }
            });
        });

        // Reorder Button Click
        document.getElementById('reorderBtn').addEventListener('click', function () {
            reorderMode = !reorderMode;

            if (reorderMode) {
                enterReorderMode();
            } else {
                exitReorderMode();
            }
        });

        // Enter Reorder Mode
        function enterReorderMode() {
            // Enable sortable
            sortable.option('disabled', false);

            // Show reorder alert
            document.getElementById('reorderAlert').classList.remove('d-none');

            // Hide pagination
            const pagination = document.getElementById('paginationSection');
            const recordInfo = document.getElementById('recordInfo');
            if (pagination) pagination.style.display = 'none';
            if (recordInfo) recordInfo.style.display = 'none';

            // Show drag handles
            document.querySelectorAll('.drag-handle').forEach(cell => cell.classList.remove('d-none'));
            document.getElementById('dragHandleHeader').classList.remove('d-none');

            // Hide action buttons
            document.querySelectorAll('.actions-cell').forEach(cell => cell.style.display = 'none');
            document.getElementById('actionsHeader').style.display = 'none';

            // Add cursor style to rows
            document.querySelectorAll('#sortableTable tr[data-id]').forEach(row => {
                row.style.cursor = 'move';
            });

            // Update button
            document.getElementById('reorderBtn').innerHTML = '<i class="fas fa-times me-2"></i>Thoát chế độ sắp xếp';
            document.getElementById('reorderBtn').classList.remove('btn-warning');
            document.getElementById('reorderBtn').classList.add('btn-secondary');
        }

        // Exit Reorder Mode
        function exitReorderMode() {
            reorderMode = false;

            // Disable sortable
            sortable.option('disabled', true);

            // Hide reorder alert
            document.getElementById('reorderAlert').classList.add('d-none');

            // Show pagination
            const pagination = document.getElementById('paginationSection');
            const recordInfo = document.getElementById('recordInfo');
            if (pagination) pagination.style.display = 'block';
            if (recordInfo) recordInfo.style.display = 'block';

            // Hide drag handles
            document.querySelectorAll('.drag-handle').forEach(cell => cell.classList.add('d-none'));
            document.getElementById('dragHandleHeader').classList.add('d-none');

            // Show action buttons
            document.querySelectorAll('.actions-cell').forEach(cell => cell.style.display = '');
            document.getElementById('actionsHeader').style.display = '';

            // Remove cursor style from rows
            document.querySelectorAll('#sortableTable tr[data-id]').forEach(row => {
                row.style.cursor = '';
            });

            // Update button
            document.getElementById('reorderBtn').innerHTML = '<i class="fas fa-arrows-alt me-2"></i>Reorder Mode';
            document.getElementById('reorderBtn').classList.remove('btn-secondary');
            document.getElementById('reorderBtn').classList.add('btn-warning');

            // Reload page to restore original order
            location.reload();
        }

        // Update order badges based on current position
        function updateOrderBadges() {
            const rows = document.querySelectorAll('#sortableTable tr[data-id]');
            rows.forEach((row, index) => {
                const badge = row.querySelector('.order-badge');
                if (badge) {
                    badge.textContent = index + 1;
                }
            });
        }

        // Save Order Button
        document.getElementById('saveOrderBtn').addEventListener('click', async function () {
            const rows = document.querySelectorAll('#sortableTable tr[data-id]');
            const orderData = [];

            rows.forEach((row, index) => {
                orderData.push({
                    id: parseInt(row.getAttribute('data-id')),
                    displayOrder: index + 1
                });
            });

            try {
                const response = await fetch('/AdminPopupBanner/UpdateOrder', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(orderData)
                });

                if (response.ok) {
                    showSuccessToast('Đã cập nhật thứ tự thành công!');
                    setTimeout(() => {
                        location.reload();
                    }, 1000);
                } else {
                    alert('Lỗi khi cập nhật thứ tự. Vui lòng thử lại.');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Đã xảy ra lỗi khi cập nhật thứ tự.');
            }
        });

        // Cancel Order Button
        document.getElementById('cancelOrderBtn').addEventListener('click', function () {
            exitReorderMode();
        });

        // Show success toast
        function showSuccessToast(message) {
            const toastHtml = `
                        <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="3000">
                            <div class="toast-header bg-success text-white">
                                <i class="fas fa-check-circle me-2"></i>
                                <strong class="me-auto">Thành công</strong>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                            </div>
                            <div class="toast-body">
                                ${message}
                            </div>
                        </div>
                    `;

            const toastContainer = document.querySelector('.toast-container');
            toastContainer.insertAdjacentHTML('beforeend', toastHtml);

            const newToast = toastContainer.lastElementChild;
            setTimeout(() => {
                $(newToast).fadeOut('slow', function () {
                    $(this).remove();
                });
            }, 3000);
        }
    </script>
}