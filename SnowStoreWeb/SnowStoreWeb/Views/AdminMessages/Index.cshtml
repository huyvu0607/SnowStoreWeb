@model IEnumerable<SnowStoreWeb.Models.Message>

@{
    ViewData["Title"] = "Message Management";
    Layout = "_AdminLayout";
}

<!-- Toast Container -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
    <div id="successToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="fas fa-check-circle me-2"></i>
                <span id="toastMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-comments me-2"></i>Message Management</h2>
                <div>
                    <button id="reorderBtn" class="btn btn-warning me-2">
                        <i class="fas fa-arrows-alt me-2"></i>Reorder Mode
                    </button>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Create New Message
                    </a>
                </div>
            </div>

            <!-- Reorder Mode Alert -->
            <div id="reorderAlert" class="alert alert-info d-none mb-4" role="alert">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Reorder Mode Active:</strong> Drag and drop rows to change order, then click "Save Order" to apply changes.
                <button id="saveOrderBtn" class="btn btn-success btn-sm ms-3">
                    <i class="fas fa-save me-1"></i>Save Order
                </button>
                <button id="cancelOrderBtn" class="btn btn-secondary btn-sm ms-2">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
            </div>

            <!-- Search and Filter Section -->
            <div class="card mb-4" id="searchFilterCard">
                <div class="card-body">
                    <form asp-action="Index" method="get" class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Search by Description</label>
                            <input type="text" name="searchTerm" value="@ViewData["CurrentFilter"]"
                                   class="form-control" placeholder="Enter description to search..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Sort By</label>
                            <select name="sortOrder" class="form-select">
                                <option value="">Order (Ascending)</option>
                                <option value="order_desc">Order (Descending)</option>
                                <option value="Description">Description (A-Z)</option>
                                <option value="desc_desc">Description (Z-A)</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-outline-primary me-2">
                                <i class="fas fa-search"></i> Search
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-undo"></i> Reset
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Multi-select Actions -->
            <form id="multiDeleteForm" asp-action="DeleteMultiple" method="post">
                <div class="d-flex justify-content-between align-items-center mb-3" id="multiSelectActions">
                    <div>
                        <button type="button" id="selectAll" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-check-square me-1"></i>Select All
                        </button>
                        <button type="button" id="deselectAll" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-square me-1"></i>Deselect All
                        </button>
                    </div>
                    <button type="submit" id="deleteSelected" class="btn btn-danger" disabled>
                        <i class="fas fa-trash me-2"></i>Delete Selected
                    </button>
                </div>

                <!-- Messages Table -->
                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th width="50" id="checkboxHeader">
                                            <input type="checkbox" id="masterCheckbox" class="form-check-input">
                                        </th>
                                        <th width="50" id="dragHandleHeader" class="d-none text-center">
                                            <i class="fas fa-grip-vertical"></i>
                                        </th>
                                        <th width="150">Image</th>
                                        <th>
                                            <a asp-action="Index" asp-route-sortOrder="@ViewData["DescSortParm"]"
                                               asp-route-searchTerm="@ViewData["CurrentFilter"]"
                                               class="text-decoration-none text-white">
                                                Description
                                                @if (ViewData["DescSortParm"]?.ToString() == "Description")
                                                {
                                                    <i class="fas fa-sort-up"></i>
                                                }
                                                else if (ViewData["DescSortParm"]?.ToString() == "desc_desc")
                                                {
                                                    <i class="fas fa-sort-down"></i>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-sort"></i>
                                                }
                                            </a>
                                        </th>
                                        <th width="100">
                                            <a asp-action="Index" asp-route-sortOrder="@ViewData["OrderSortParm"]"
                                               asp-route-searchTerm="@ViewData["CurrentFilter"]"
                                               class="text-decoration-none text-white">
                                                Order
                                                @if (ViewData["OrderSortParm"]?.ToString() == "order_desc")
                                                {
                                                    <i class="fas fa-sort-down"></i>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-sort-up"></i>
                                                }
                                            </a>
                                        </th>
                                        <th width="200" id="actionsHeader">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="sortableTable">
                                    @if (Model.Any())
                                    {
                                        @foreach (var item in Model)
                                        {
                                            <tr data-id="@item.Id">
                                                <td class="checkbox-cell">
                                                    <input type="checkbox" name="selectedIds" value="@item.Id"
                                                           class="form-check-input row-checkbox">
                                                </td>
                                                <td class="drag-handle d-none text-center" style="cursor: move;">
                                                    <i class="fas fa-grip-vertical text-muted"></i>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                    {
                                                        <img src="@item.ImageUrl" alt="Message Image"
                                                             class="img-thumbnail" style="max-width: 120px; max-height: 80px; object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-light border rounded d-flex align-items-center justify-content-center"
                                                             style="width: 120px; height: 80px;">
                                                            <i class="fas fa-image text-muted"></i>
                                                        </div>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="fw-medium">@Html.DisplayFor(modelItem => item.Description)</span>
                                                </td>
                                                <td>
                                                    <span class="badge bg-primary order-badge">@Html.DisplayFor(modelItem => item.Order)</span>
                                                </td>
                                                <td class="actions-cell">
                                                    <div class="btn-group" role="group">
                                                        <a asp-action="Details" asp-route-id="@item.Id"
                                                           class="btn btn-sm btn-outline-info" title="View Details">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                                           class="btn btn-sm btn-outline-primary" title="Edit">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                                onclick="deleteMessage(@item.Id, '@item.Description')" title="Delete">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-4">
                                                <div class="text-muted">
                                                    <i class="fas fa-inbox fa-2x mb-3"></i>
                                                    <p>No messages found.</p>
                                                    <a asp-action="Create" class="btn btn-primary">
                                                        <i class="fas fa-plus me-2"></i>Create First Message
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this message?</p>
                <p><strong id="messageToDelete"></strong></p>
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    This action cannot be undone. The associated image will also be deleted.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-2"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SortableJS CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>

    <script>
        // Show toast notification if TempData exists
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                    document.addEventListener('DOMContentLoaded', function() {
                        showToast('@Html.Raw(TempData["SuccessMessage"])');
                            });
            </text>
        }

            // Toast notification function
            function showToast(message) {
                const toastElement = document.getElementById('successToast');
                const toastMessageElement = document.getElementById('toastMessage');

                toastMessageElement.textContent = message;

                const toast = new bootstrap.Toast(toastElement, {
                    autohide: true,
                    delay: 3000
                });

                toast.show();
            }

        // Reorder Mode Variables
        let reorderMode = false;
        let sortable = null;

        // Initialize Sortable
        document.addEventListener('DOMContentLoaded', function () {
            const tbody = document.getElementById('sortableTable');

            sortable = new Sortable(tbody, {
                animation: 150,
                disabled: true,
                ghostClass: 'table-warning',
                dragClass: 'table-info',
                forceFallback: true,
                onEnd: function (evt) {
                    updateOrderBadges();
                }
            });
        });

        // Reorder Button Click
        document.getElementById('reorderBtn').addEventListener('click', function () {
            reorderMode = !reorderMode;

            if (reorderMode) {
                enterReorderMode();
            } else {
                exitReorderMode();
            }
        });

        // Enter Reorder Mode
        function enterReorderMode() {
            // Enable sortable
            sortable.option('disabled', false);

            // Show reorder alert
            document.getElementById('reorderAlert').classList.remove('d-none');

            // Hide search/filter and multi-select
            document.getElementById('searchFilterCard').style.display = 'none';
            document.getElementById('multiSelectActions').style.display = 'none';

            // Hide checkboxes, show drag handles
            document.querySelectorAll('.checkbox-cell').forEach(cell => cell.classList.add('d-none'));
            document.querySelectorAll('.drag-handle').forEach(cell => cell.classList.remove('d-none'));
            document.getElementById('checkboxHeader').classList.add('d-none');
            document.getElementById('dragHandleHeader').classList.remove('d-none');

            // Hide action buttons
            document.querySelectorAll('.actions-cell').forEach(cell => cell.style.display = 'none');
            document.getElementById('actionsHeader').style.display = 'none';

            // Add cursor style to rows
            document.querySelectorAll('#sortableTable tr[data-id]').forEach(row => {
                row.style.cursor = 'move';
            });

            // Update button
            document.getElementById('reorderBtn').innerHTML = '<i class="fas fa-times me-2"></i>Exit Reorder Mode';
            document.getElementById('reorderBtn').classList.remove('btn-warning');
            document.getElementById('reorderBtn').classList.add('btn-secondary');
        }

        // Exit Reorder Mode
        function exitReorderMode() {
            reorderMode = false;

            // Disable sortable
            sortable.option('disabled', true);

            // Hide reorder alert
            document.getElementById('reorderAlert').classList.add('d-none');

            // Show search/filter and multi-select
            document.getElementById('searchFilterCard').style.display = 'block';
            document.getElementById('multiSelectActions').style.display = 'flex';

            // Show checkboxes, hide drag handles
            document.querySelectorAll('.checkbox-cell').forEach(cell => cell.classList.remove('d-none'));
            document.querySelectorAll('.drag-handle').forEach(cell => cell.classList.add('d-none'));
            document.getElementById('checkboxHeader').classList.remove('d-none');
            document.getElementById('dragHandleHeader').classList.add('d-none');

            // Show action buttons
            document.querySelectorAll('.actions-cell').forEach(cell => cell.style.display = '');
            document.getElementById('actionsHeader').style.display = '';

            // Remove cursor style from rows
            document.querySelectorAll('#sortableTable tr[data-id]').forEach(row => {
                row.style.cursor = '';
            });

            // Update button
            document.getElementById('reorderBtn').innerHTML = '<i class="fas fa-arrows-alt me-2"></i>Reorder Mode';
            document.getElementById('reorderBtn').classList.remove('btn-secondary');
            document.getElementById('reorderBtn').classList.add('btn-warning');

            // Reload page to restore original order
            location.reload();
        }

        // Update order badges based on current position
        function updateOrderBadges() {
            const rows = document.querySelectorAll('#sortableTable tr[data-id]');
            rows.forEach((row, index) => {
                const badge = row.querySelector('.order-badge');
                if (badge) {
                    badge.textContent = index;
                }
            });
        }

        // Save Order Button
        document.getElementById('saveOrderBtn').addEventListener('click', async function () {
            const rows = document.querySelectorAll('#sortableTable tr[data-id]');
            const orderData = [];

            rows.forEach((row, index) => {
                orderData.push({
                    id: parseInt(row.getAttribute('data-id')),
                    order: index
                });
            });

            try {
                const response = await fetch('/AdminMessages/UpdateOrder', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(orderData)
                });

                if (response.ok) {
                    showToast('Order updated successfully!');
                    setTimeout(() => {
                        location.reload();
                    }, 1000);
                } else {
                    alert('Failed to update order. Please try again.');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred while updating order.');
            }
        });

        // Cancel Order Button
        document.getElementById('cancelOrderBtn').addEventListener('click', function () {
            exitReorderMode();
        });

        // Master checkbox functionality
        document.getElementById('masterCheckbox').addEventListener('change', function () {
            const checkboxes = document.querySelectorAll('.row-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
            updateDeleteButton();
        });

        // Individual checkbox change
        document.addEventListener('change', function (e) {
            if (e.target.classList.contains('row-checkbox')) {
                updateDeleteButton();
                updateMasterCheckbox();
            }
        });

        // Select All button
        document.getElementById('selectAll').addEventListener('click', function () {
            const checkboxes = document.querySelectorAll('.row-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = true;
            });
            document.getElementById('masterCheckbox').checked = true;
            updateDeleteButton();
        });

        // Deselect All button
        document.getElementById('deselectAll').addEventListener('click', function () {
            const checkboxes = document.querySelectorAll('.row-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = false;
            });
            document.getElementById('masterCheckbox').checked = false;
            updateDeleteButton();
        });

        // Update delete button state
        function updateDeleteButton() {
            const checkedBoxes = document.querySelectorAll('.row-checkbox:checked');
            const deleteButton = document.getElementById('deleteSelected');
            deleteButton.disabled = checkedBoxes.length === 0;

            if (checkedBoxes.length > 0) {
                deleteButton.innerHTML = `<i class="fas fa-trash me-2"></i>Delete Selected (${checkedBoxes.length})`;
            } else {
                deleteButton.innerHTML = `<i class="fas fa-trash me-2"></i>Delete Selected`;
            }
        }

        // Update master checkbox state
        function updateMasterCheckbox() {
            const checkboxes = document.querySelectorAll('.row-checkbox');
            const checkedBoxes = document.querySelectorAll('.row-checkbox:checked');
            const masterCheckbox = document.getElementById('masterCheckbox');

            if (checkedBoxes.length === 0) {
                masterCheckbox.indeterminate = false;
                masterCheckbox.checked = false;
            } else if (checkedBoxes.length === checkboxes.length) {
                masterCheckbox.indeterminate = false;
                masterCheckbox.checked = true;
            } else {
                masterCheckbox.indeterminate = true;
            }
        }

        // Multi-delete confirmation
        document.getElementById('multiDeleteForm').addEventListener('submit', function (e) {
            const checkedBoxes = document.querySelectorAll('.row-checkbox:checked');
            if (checkedBoxes.length === 0) {
                e.preventDefault();
                return;
            }

            if (!confirm(`Are you sure you want to delete ${checkedBoxes.length} message(s)? This action cannot be undone.`)) {
                e.preventDefault();
            }
        });

        // Single delete function
        function deleteMessage(id, description) {
            document.getElementById('messageToDelete').textContent = description;
            document.getElementById('deleteForm').action = '/AdminMessages/Delete/' + id;

            const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
}